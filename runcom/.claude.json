{
  "mcpServers": {
    "semble": {
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]==0.7.0",
        "semble"
      ],
      "type": "stdio"
    },
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian",
        "--env-file",
        "/Users/amikai/.config/mcp-atlassian/.env"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--open-web-dashboard",
        "false"
      ],
      "env": {}
    },
    "launchpad": {
      "type": "http",
      "url": "https://launchpad.apps.moxa.live/mcp",
      "oauth": {
        "clientId": "9ab45744-19d5-43e0-9949-cba70aa29a82"
      }
    }
  }
}