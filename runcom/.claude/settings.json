{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "LSP",
      "Agent(Explore)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(go *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue view)",
      "Bash(gh issue view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "mcp__serena__*"
    ],
    "ask": [
      "mcp__serena__execute_shell_command",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh pr create *)",
      "Bash(gh pr create)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue create)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue delete *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh gist create *)",
      "Bash(gh gist delete *)",
      "Bash(gh gist edit *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "drawio@drawio": true,
    "pilotfish@pilotfish": false,
    "cc-image-view@cc-mod-image-view": true,
    "cc-plugin-you-should-know@builtin": true,
    "cc-skills-golang@samber": true,
    "ppt-master@ppt-master": true,
    "pstack@pstack-claude": true,
    "prismantis@prismantis": true,
    "model-relay@model-relay": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "drawio": {
      "source": {
        "source": "github",
        "repo": "jgraph/drawio-mcp"
      }
    },
    "pilotfish": {
      "source": {
        "source": "github",
        "repo": "Nanako0129/pilotfish"
      }
    },
    "cc-mod-image-view": {
      "source": {
        "source": "github",
        "repo": "GGGODLIN/cc-mod-image-view"
      }
    },
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "ppt-master": {
      "source": {
        "source": "github",
        "repo": "hugohe3/ppt-master"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    },
    "prismantis": {
      "source": {
        "source": "github",
        "repo": "NahumLitvin/prismantis"
      }
    },
    "model-relay": {
      "source": {
        "source": "github",
        "repo": "cablate/model-relay"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark"
}
