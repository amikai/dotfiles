{
  "context_servers": {"semble": {"command": "uvx", "args": ["--from", "semble[mcp]==0.7.0", "semble"]}},
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  },
  "buffer_font_family": "Maple Mono Normal NF CN",
  "buffer_font_fallbacks": [
    "JetBrainsMono Nerd Font Mono",
    "Hack Nerd Font"
  ],
  "git_panel": {
    "tree_view": true
  },
  "vim_mode": true
}
